# ---------------------------------------------------------------------------
# Edu Flow - local environment template
#
# Copy to .env.local and fill in your own values:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project URL from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Public / anon key from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key from Supabase Dashboard > Project Settings > API.
# Server-only: never expose to client code or commit to git.
SUPABASE_SERVICE_ROLE_KEY=


# --- SMS (GreenWeb) ---------------------------------------------------------
# "demo" (default) logs instead of sending real SMS and uses a built-in
# demo token. Set to "production" only when you have a real GreenWeb account.
SMS_MODE=demo

# Required only when SMS_MODE=production. GreenWeb SMS API token.
GREENWEB_SMS_TOKEN=

# Optional endpoint overrides. Defaults shown below are used if unset.
GREENWEB_SMS_API_URL=https://api.greenweb.com.bd/api.php?json
GREENWEB_SMS_INFO_URL=https://api.greenweb.com.bd/g_api.php


# ---------------------------------------------------------------------------
# Supabase Edge Function (supabase/functions/generate-monthly-ledgers)
# These are set as Edge Function secrets, not in the Next.js app env.
# Set locally with:
#   supabase secrets set --env-file .env.local
# ---------------------------------------------------------------------------

# Edge Function project URL. Usually identical to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Shared secret checked by the scheduled ledger function.
CRON_SECRET=

# IANA timezone used to decide when monthly billing windows open.
LEDGER_TIMEZONE=Asia/Dhaka
